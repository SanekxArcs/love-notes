# Sanity project used by this deployment.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-27

# Server-only Sanity token with permission to read and write this project.
SANITY_API_TOKEN=

# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Gemini is configured per user in the profile and is intentionally not an
# application-wide environment variable.
